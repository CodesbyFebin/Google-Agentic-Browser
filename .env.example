# Local SQLite database for the optional Next.js API routes.
# Use production secrets only through your deployment environment.
DATABASE_URL="file:./dev.db"

# Optional: live Gemini AI Studio plans and chat. Server-only; never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Google Drive metadata read-only OAuth. Enable Google Drive API in Cloud Console.
# Add the exact callback URL as an authorized redirect URI in your OAuth client.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_SESSION_SECRET=""
