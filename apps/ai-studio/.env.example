# GEMINI_API_KEY: Required for server-side Gemini AI API calls (@google/genai).
# AI Studio injects this automatically at runtime from user secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Stable public API default; only use Hydrogen if your key has access.
GEMINI_MODEL="gemini-3.1-flash-lite"

# Local-only explicit opt in: permits live Gemini calls without Firebase sign-in
# during development. NEVER enable this in a production deployment.
GEMINI_ALLOW_GUEST_DEV="false"

# Live Google Workspace account writes remain OFF unless deliberately enabled
# in the server environment, and every write still needs user sign-in, OAuth
# authorization and one-time approval.
ENABLE_APPROVED_GOOGLE_WRITES="false"

# APP_URL: The URL where this applet is hosted (injected by AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# GOOGLE_SESSION_SECRET: Server-side HMAC secret for signing time-limited approval tokens.
# Set a strong random 32+ byte secret in Cloud Run / production environments.
GOOGLE_SESSION_SECRET=""
